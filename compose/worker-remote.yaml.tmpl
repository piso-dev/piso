# Cloud-ship worker: its own machine, never the standalone gateway host.
# The agent is root here — the machine exists to run it, so hand it the machine
# rather than a slice of it. What that buys: /host (the whole host filesystem,
# rw), the host's namespaces (pid/ipc/uts/cgroup + privileged, so
# `nsenter -t 1 -a` is the literal handoff), and the docker socket for sibling
# containers. worker/CAPABILITIES.ship.md is the matching contract; the local
# hull keeps the hardened template (compose/worker.yaml.tmpl) and the guest
# contract, because there the host holds the vault.
#
# What is deliberately NOT widened: model/API egress still goes through the
# assigned gateway, and this box must stay a pure ship — `piso worker launch`
# refuses to run one on a standalone gateway host. Do not put this compose on
# piso_vpc.
#
# THAT EGRESS RULE IS A HOST-LEVEL SETUP STEP, NOT A CONTAINER ONE. HTTP_PROXY
# here is only convenience: it points clients at the local forwarder, and a
# privileged container can ignore or undo it. Containment comes from the
# machine's routing — force all traffic through the assigned gateway (VPC route
# / no other default route on the worker host). With PRIVILEGED + the docker
# socket, a NET_ADMIN-capable worker could add its own route or run a
# `--network host` sibling, so the routing must be enforced off-box.
name: piso-PROJ-SLUG

services:
  worker:
    image: piso-worker
    build:
      context: "WORKER_BUILD_CONTEXT"
      network: host
      args:
        PISO_WORKER_HASH: __WORKER_HASH__
    labels:
      piso.worker.hash: __WORKER_HASH__
      piso.hull: cloud_ship
    container_name: piso-worker-PROJ-SLUG
    restart: unless-stopped
    stdin_open: true
    tty: true
    privileged: true            # all capabilities, all devices
    pid: host                   # host processes visible; nsenter -t 1 works
    ipc: host
    uts: host
    cgroup: host                # host cgroup view (systemd, resource scripts)
    userns_mode: host           # container root IS host root under userns-remap
    volumes:
      - "/:/host"                                       # whole host filesystem, rw
      - "/var/run/docker.sock:/var/run/docker.sock"     # drive host containers
      - "PROJECT_DIR:/workspace"                         # scratch root; tasks clone to <owner>/<repo>
      - piso-agent-PROJ-SLUG:/root/.pi/agent
      - "CA_DIR/workers/PROJ-SLUG/ca.crt:/piso-ca.pem:ro"
      - "CA_DIR/workers/PROJ-SLUG:/etc/piso"
      - "CA_DIR/pi-profile:/opt/piso/pi-profile:ro"
    environment:
      HTTPS_PROXY: http://127.0.0.1:18080
      HTTP_PROXY: http://127.0.0.1:18080
      ALL_PROXY: http://127.0.0.1:18080
      https_proxy: http://127.0.0.1:18080
      http_proxy: http://127.0.0.1:18080
      all_proxy: http://127.0.0.1:18080
      PISO_EGRESS_UPSTREAM: "__EGRESS_UPSTREAM__"
      NO_PROXY: localhost,127.0.0.1
      no_proxy: localhost,127.0.0.1
      SSL_CERT_FILE: /piso-ca.pem
      CURL_CA_BUNDLE: /piso-ca.pem
      GIT_SSL_CAINFO: /piso-ca.pem
      REQUESTS_CA_BUNDLE: /piso-ca.pem
      NODE_EXTRA_CA_CERTS: /piso-ca.pem
      GATEWAY_URL: "__GATEWAY_API__"
      PISO_WORKER_TOKEN: "__WORKER_TOKEN__"
      PISO_WORKER_NAME: piso-worker-PROJ-SLUG
      PISO_WORKER_SLUG: PROJ-SLUG
      PISO_HULL: cloud_ship
      # Task-first standalone workers pull runnable work from their shared queue.
      PISO_TASK_LOOP: "1"
      PISO_PUBLIC_URL_FILE: /etc/piso/public-url
      PISO_EGRESS_LISTEN_PORT: "18080"
      PLANNOTATOR_REMOTE: "1"
      PLANNOTATOR_PORT: "19432"
      PLANNOTATOR_DATA_DIR: /tmp/plannotator
      NPM_CONFIG_CACHE: /root/.pi/agent/.npm-cache
      TMPDIR: /root/.pi/agent/tmp
      NODE_COMPILE_CACHE: /root/.pi/agent/.node-compile-cache
    init: true

volumes:
  piso-agent-PROJ-SLUG:
    name: piso-agent-PROJ-SLUG
