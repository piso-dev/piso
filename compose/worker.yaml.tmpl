# piso worker compose — generated per-project by `piso up`.
# PKG placeholders are substituted by the CLI; do not edit by hand.
#
# The worker joins piso_vpc only (external, created by the gateway compose).
# That network is internal: the worker cannot be forwarded off the bridge.
# Do not attach this service to piso_egress — that is the gateway's NAT path.
name: piso-PROJ-SLUG

services:
  worker:
    # One image for every project. A new directory must not rebuild (or
    # worse, bake an empty stub and then npm-install through the gateway).
    image: piso-worker
    build:
      context: WORKER_BUILD_CONTEXT
      network: host
      args:
        PISO_WORKER_HASH: __WORKER_HASH__
    labels:
      piso.worker.hash: __WORKER_HASH__
    container_name: piso-worker-PROJ-SLUG
    restart: unless-stopped
    stdin_open: true
    tty: true
    volumes:
      - PROJECT_DIR:/workspace          # the only host files the agent sees
      - piso-agent-PROJ-SLUG:/root/.pi/agent   # pi sessions/npm persist
      - CA_DIR/ca.crt:/piso-ca.pem:ro   # trust the gateway's MITM CA
      - CA_DIR/workers/PROJ-SLUG/placeholders.env:/etc/piso/placeholders.env:ro
      - CA_DIR/pi-profile/settings.json:/root/.pi/agent/settings.json:ro
      - CA_DIR/pi-profile/models.json:/root/.pi/agent/models.json:ro
    environment:
      HTTPS_PROXY: http://gateway:8080
      HTTP_PROXY: http://gateway:8080
      NO_PROXY: gateway,localhost,127.0.0.1,*.piso.local
      GATEWAY_URL: http://gateway:8083
      PISO_WORKER_NAME: piso-worker-PROJ-SLUG
      PISO_WORKER_SLUG: PROJ-SLUG
      # Plannotator plan-review binds this port inside the worker. A
      # sidecar asks the gateway to show a Plan review chip; the host
      # approves and opens https://plan-PROJ-SLUG.piso.local via ingress.
      PLANNOTATOR_REMOTE: "1"
      PLANNOTATOR_PORT: "19432"
      # ~/.plannotator (data dir) sits on the read-only rootfs; use the
      # tmpfs-backed /tmp so review sessions can persist plans/history.
      PLANNOTATOR_DATA_DIR: /tmp/plannotator
      NPM_CONFIG_CACHE: /root/.pi/agent/.npm-cache
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    init: true
    read_only: true
    tmpfs:
      - /tmp
      - /run
      - /root/.cache
      - /root/.npm
    networks:
      - vpc

networks:
  vpc:
    name: piso_vpc
    external: true

volumes:
  piso-agent-PROJ-SLUG:
    name: piso-agent-PROJ-SLUG